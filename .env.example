# ─── Server Configuration ───
PORT=3001
WS_PORT=3001
NODE_ENV=development

# ─── JWT Auth ───
# IMPORTANT: Replace with a strong random secret in production
JWT_SECRET=dev-whiteboard-secret-change-in-production
JWT_EXPIRES_IN=7d

# ─── PostgreSQL (Phase 2 - optional, server works without it) ───
# DATABASE_URL=postgresql://whiteboard:whiteboard@localhost:5432/whiteboard

# ─── S3-Compatible Storage (Phase 2 - optional) ───
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=whiteboard-snapshots
# S3_REGION=us-east-1

# ─── Redis (Phase 3 - optional, for presence fanout) ───
# REDIS_URL=redis://localhost:6379

# ─── Room Encryption (Phase 2) ───
# ENCRYPTION_ENABLED=false
